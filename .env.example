# Local development ONLY. Do not deploy these sample credentials.
POSTGRES_DB=test_quality_lab
POSTGRES_USER=tql_dev
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://tql_dev:change-me-local-only@postgres:5432/test_quality_lab
# Supabase session pooler example (port 5432); keep the real URL only in ignored .env:
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<encoded-password>@<pooler-host>:5432/postgres?sslmode=require&connect_timeout=5
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000
ARTIFACT_DIR=/app/artifacts
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_SENDER=Test Quality Lab <no-reply@localhost>
# Real email via Gmail (see docs/development/setup.md "Sending real email"). Replace the
# block above with the lines below; the password is a Gmail App password, keep it only in .env:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_SENDER=Test Quality Lab <sender@gmail.com>
# SMTP_USERNAME=sender@gmail.com
# SMTP_PASSWORD=<16-character-app-password>
PUBLIC_APP_URL=http://localhost:5173
