# Local development ONLY. Do not deploy these sample credentials.
POSTGRES_DB=test_quality_lab
POSTGRES_USER=tql_dev
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://tql_dev:change-me-local-only@postgres:5432/test_quality_lab
# Supabase session pooler example (port 5432); keep the real URL only in ignored .env:
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<encoded-password>@<pooler-host>:5432/postgres?sslmode=require&connect_timeout=5
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000
ARTIFACT_DIR=/app/artifacts
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_SENDER=Test Quality Lab <no-reply@localhost>
# For a remote SMTP server, use starttls or ssl, a verified sender, and credentials:
# SMTP_SECURITY=starttls
# SMTP_SENDER=no-reply@example.com
# SMTP_USERNAME=<smtp-user>
# SMTP_PASSWORD=<smtp-password>
PUBLIC_APP_URL=http://localhost:5173
